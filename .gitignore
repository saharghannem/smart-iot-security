# ==========================================
# SecureGate / Smart IoT Security - Git Ignore
# ==========================================

# --- Secrets, API Keys & Credentials ---
.env
.env.*
!.env.example
*.env

# Firebase Service Account Private Keys
*firebase-adminsdk*.json
!firebase-service-account.example.json

# Arduino & ESP32 Hardware Credentials
config.h
!config.h.example
camera_config.h
!camera_config.h.example

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/

# --- Node.js & Angular ---
node_modules/
.angular/
dist/
tmp/
out-tsc/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Capacitor mobile builds
android/
ios/

# --- IDEs & OS Files ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db

# --- Logs & Temporary Files ---
*.log
*.tmp
*.bak

# --- Compressed Local Backups (Archived snapshots) ---
*.zip
*.tar
*.gz
*.rar
